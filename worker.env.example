# Settings for the analysis worker (worker.py), read from a file called worker.env beside it. Keep your real
# worker.env private: it is not needed in git.

# Where to reach the bot's machine, as user@host, and the private key that is locked to worker_gateway.py there.
GATEWAY_TARGET=user@host
GATEWAY_KEY=C:\path\to\the\private\key

# The chess engine.
STOCKFISH_PATH=C:\path\to\stockfish.exe

# Optional, with their defaults.
# ENGINE_THREADS=8
# ENGINE_HASH_MB=512
# NODES_PER_POSITION=200000
# SECONDS_PER_POSITION_LIMIT=60
# BATCH_SIZE=20
# IDLE_SLEEP_SECONDS=300
# MIN_PLIES=6
# LICHESS_MIN_INTERVAL_SECONDS=2
# REQUEST_TIMEOUT_SECONDS=30

# A way for Chess.com and Lichess to reach whoever runs the worker (an address or a URL), sent in its User-Agent.
# CONTACT=

# For running as a service: a log file, and the known_hosts file ssh should use (a service account has its own).
# LOG_FILE=C:/path/to/worker.log
# GATEWAY_KNOWN_HOSTS=C:/path/to/known_hosts
