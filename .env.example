# The bot's token, from the Discord Developer Portal (Bot page). Keep your real .env private.
DISCORD_TOKEN=

# A way for Chess.com and Lichess to reach whoever runs the bot if it misbehaves: an email
# address or a URL. It is sent in the User-Agent of requests to those sites.
CONTACT=

# Optional: where the database file lives. The default is beside the code. To keep it on a larger
# disk, give a file inside a folder that already exists on that disk. If the folder is missing (for
# example the disk isn't mounted yet) the bot refuses to start, so it never makes a new empty database.
# PLAYMOREBLITZ_DB=/mnt/archive/playmoreblitz/playmoreblitz.db
